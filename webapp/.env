# API anahtarı GEREKMEZ. Bu uygulama "claude" CLI'ını arka planda çalıştırır ve
# "claude auth login" ile giriş yaptığınız claude.ai (Pro/Max) hesabınızı kullanır.
# Terminalde `claude auth status` ile giriş yapmış olduğunuzu doğrulayabilirsiniz.

# Opsiyonel ayarlar (varsayılanlar iyi çalışır, dokunmanıza gerek yok):
CLAUDE_MODEL=sonnet      # 'opus' daha güçlü ama Pro kullanım kotanızı daha hızlı tüketir
# Effort tura göre seçilir: sıradan turlar CLAUDE_EFFORT, kritik turlar
# (karşılaşma, senarist beat'i, yüksek gerilim, ölüme yakın karakter, açılış)
# CLAUDE_EFFORT_KEY seviyesinde çalışır. İkisini eşitlerseniz effort sabitlenir.
CLAUDE_EFFORT=medium
CLAUDE_EFFORT_KEY=high
CLAUDE_TIMEOUT_SECONDS=300
PORT=5050

# --- Kimlik (sunucu dışarı açıksa MUTLAKA değiştirin) -------------------
GM_PIN=1111              # /secrets (Anlatıcı Ekranı) girişi
GAME_CODE=kizil          # oyuncu karakterini İLK KEZ alırken sorulan davet kodu
# SECRET_KEY=            # boşsa data/secret_key içinde üretilip saklanır
# COOKIE_SECURE=1        # HTTPS arkasındaysanız 1 yapın (çerez yalnız TLS'te gider)
# SESSION_DAYS=30        # oturum kaç gün açık kalsın
# SINGLE_SCREEN=0        # tek ekran kipi varsayılanı (oyun içinden de açılır)
